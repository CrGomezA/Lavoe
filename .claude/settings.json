{
  "permissions": {
    "deny": [
      "Edit(/README.md)"
    ],
    "ask": [
      "Edit(/.claude/settings.json)",
      "Edit(/.claude/hooks/**)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/proteger-readme.sh\""
          }
        ]
      }
    ]
  }
}
